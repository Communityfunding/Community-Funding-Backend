# Community Fundings — backend configuration
# Copy to .env and fill in. Never commit .env.
# Values come from the team's AWS, Clerk, Stripe and Railway accounts.

# ── Database (required) ──────────────────────────────────────────────
# PostgreSQL connection string. Local development uses the shared dev
# instance; ask the team for the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cf-db?sslmode=require

# ── Backend sessions (required) ──────────────────────────────────────
# Signs the session tokens the API issues. Use a long random value.
# If unset, the code falls back to a default that is public in this repo.
JWT_SECRET_KEY=
# Optional: defaults are HS256 and 60 minutes.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Clerk (sign-in) ──────────────────────────────────────────────────
# From the Clerk dashboard, for the same instance the frontend uses.
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISS=https://YOUR-INSTANCE.clerk.accounts.dev
# Optional: only set if the Clerk token defines an audience.
CLERK_AUD=
# Alternative to JWKS: a PEM public key, if JWKS is unavailable.
CLERK_PEM_PUBLIC_KEY=

# ── URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Optional: extra allowed origins, comma separated. localhost is always allowed.
CORS_ORIGINS=

# ── Stripe ───────────────────────────────────────────────────────────
# Use test-mode keys (sk_test_..., pk_test_...) for development.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe webhook endpoint, or the Stripe CLI when testing locally.
STRIPE_WEBHOOK_SECRET=
# Optional: platform fee percentage, defaults to 5.0
PLATFORM_FEE_PERCENT=5.0

# ── AWS S3 (campaign photos and video) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only for temporary credentials.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-2
AWS_S3_BUCKET=community-fundings-assets
# Optional: key prefix inside the bucket, defaults to Campaigns
S3_KEY_PREFIX=Campaigns

# ── Campaign bank details encryption ─────────────────────────────────
# Fernet key. Required to save a campaign's payment step.
# Generate one for local use:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never use the production key locally: it decrypts real bank details.
BANK_ENCRYPTION_KEY=

# ── Email (collaborator invitations) ─────────────────────────────────
# Optional. Invitations are skipped and logged when unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Local development only ───────────────────────────────────────────
# DEV_JWT_BYPASS=true disables token verification entirely.
# Leave unset. Never enable on a deployed environment.
DEV_JWT_BYPASS=false
